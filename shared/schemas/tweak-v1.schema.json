{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tweak BigZ v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "description",
    "editions",
    "risk",
    "securityImpact",
    "source",
    "phase",
    "scope",
    "requires",
    "dependsOn",
    "conflictsWith",
    "action",
    "verify",
    "rollback",
    "restart"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "editions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "dev",
          "balanced",
          "full-performance"
        ]
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "securityImpact": {
      "enum": [
        "none",
        "reducesProtection"
      ]
    },
    "source": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "phase": {
      "enum": [
        "online",
        "offline"
      ]
    },
    "scope": {
      "enum": [
        "currentUser",
        "image",
        "defaultUser"
      ]
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builds",
        "architectures",
        "admin"
      ],
      "properties": {
        "builds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "x64"
          }
        },
        "admin": {
          "type": "boolean"
        }
      }
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "conflictsWith": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "action": {
      "type": "object"
    },
    "verify": {
      "type": "object"
    },
    "rollback": {
      "type": "object"
    },
    "restart": {
      "enum": [
        "none",
        "logoff",
        "reboot"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "phase": {
          "const": "online"
        },
        "scope": {
          "const": "currentUser"
        },
        "requires": {
          "properties": {
            "admin": {
              "const": false
            }
          }
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "key",
            "name",
            "valueType",
            "value"
          ],
          "properties": {
            "type": {
              "const": "registry.setValue"
            },
            "key": {
              "type": "string",
              "pattern": "^HKCU\\\\"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "valueType": {
              "const": "DWord"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          }
        },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "registry.matchesAction"
            }
          }
        },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "restoreSnapshot"
            }
          }
        }
      }
    },
    {
      "properties": {
        "phase": {
          "const": "offline"
        },
        "scope": {
          "const": "image"
        },
        "requires": {
          "properties": {
            "admin": {
              "const": true
            }
          }
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "packageName"
          ],
          "properties": {
            "type": {
              "const": "appx.deprovision"
            },
            "packageName": {
              "enum": [
                "Microsoft.BingNews",
                "Clipchamp.Clipchamp",
                "Microsoft.MicrosoftSolitaireCollection"
              ]
            }
          }
        },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "appx.absent"
            }
          }
        },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "rebuildImage"
            }
          }
        }
      }
    },
    {
      "properties": {
        "phase": {
          "const": "offline"
        },
        "scope": {
          "const": "defaultUser"
        },
        "requires": {
          "properties": {
            "admin": {
              "const": true
            }
          }
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "hive",
            "key",
            "name",
            "valueType",
            "value"
          ],
          "properties": {
            "type": {
              "const": "registry.setOfflineValue"
            },
            "hive": {
              "const": "defaultUser"
            },
            "key": {
              "const": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced"
            },
            "name": {
              "const": "HideFileExt"
            },
            "valueType": {
              "const": "DWord"
            },
            "value": {
              "const": 0
            }
          }
        },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "registry.matchesAction"
            }
          }
        },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "rebuildImage"
            }
          }
        }
      }
    }
  ]
}
